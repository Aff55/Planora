# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* values at bundle time, so
# restart the Expo server after changing anything here.

# Where the app looks for the Planora API.
#
# app.json falls back to http://localhost:4000/api, which only works in a
# simulator - on a physical phone "localhost" is the phone itself, not your
# computer. Set your machine's LAN address here when testing on a device.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api

# Developer tooling in the UI: the "Development API" field on the sign-in screen
# and the "Development server" card in Settings.
#
# Expo Go always runs with __DEV__ === true, so these would otherwise be visible
# to everyone, including during a demo. Off unless explicitly set to 1.
EXPO_PUBLIC_SHOW_DEV_TOOLS=0
