DATABASE_URL="postgresql://planora:planora@localhost:5432/planora?schema=public"
REDIS_URL="redis://:planora-local-redis@localhost:6379"
JWT_SECRET="change-this-in-production-with-32-random-bytes"
JWT_EXPIRES_IN="12h"
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
TRUST_PROXY_HOPS="0"
MAX_ACTIVE_SESSIONS_PER_USER="20"
MAX_TASKS_PER_USER="2000"
MAX_CALENDAR_EVENTS_PER_USER="5000"
MAX_ACTIVITIES_PER_USER="10000"
MAX_MOOD_LOGS_PER_USER="5000"
MAX_SLEEP_LOGS_PER_USER="5000"
MAX_WATER_LOGS_PER_USER="20000"
MAX_JOURNAL_ENTRIES_PER_USER="2000"
MAX_SUBTASKS_PER_TASK="30"
MAX_DASHBOARD_TASKS="50"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="planora-pro"
# Set to 1 while fine-tuning locally: keeps the API from loading the app model
# into VRAM and evicting the training teacher model.
PLANORA_SKIP_MODEL_WARMUP=""
LOCAL_EMBEDDING_MODEL="nomic-embed-text"
